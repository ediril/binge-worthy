RewriteEngine On

# Force HTTPS redirect
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.bingeworthyshows\.tv$ [NC]
RewriteRule ^(.*)$ https://bingeworthyshows.tv/$1 [L,R=301]

# Only allow bingeworthyshows.tv for PHP pages (not static assets)
RewriteCond %{HTTP_HOST} !^bingeworthyshows\.tv$ [NC]
RewriteCond %{REQUEST_URI} !^/static/
RewriteRule ^ - [R=404,L]

# Redirect old .php URLs to clean URLs (except API endpoints)
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/suggestions\.php$
RewriteRule ^ /%1? [R=301,L]

# Clean URL rules for existing pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(index|about|admin|categories|channel|suggestions)/?$ $1.php [L,QSA,E=REDIRECT:1]

# Default fallback to index.php (for 404 or other handling)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

# Allow direct access to static files
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# PHP settings
<IfModule mod_php.c>
    php_flag display_errors On
    php_value error_reporting E_ALL
</IfModule>