RewriteEngine On

# Disable directory listings
Options -Indexes

# Force HTTPS redirect
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect old .php URLs to clean URLs (except API endpoints)
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/bingeworthy/suggestions\.php$
RewriteCond %{REQUEST_URI} !^/bingeworthy/admin\.php$
RewriteCond %{REQUEST_URI} !^/bingeworthy/admin_ajax\.php$
RewriteCond %{REQUEST_URI} !^/bingeworthy/api/
RewriteRule ^ /%1 [R=301,L,QSA]

# Channel slug URLs - route /channel/slug-name to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^channel/([a-zA-Z0-9-]+)/?$ index.php?slug=$1 [L,QSA]

# Video slug URLs - route /play/slug-name to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^play/([a-zA-Z0-9-]+)/?$ index.php?video_slug=$1 [L,QSA]

# Category slug URLs - route /categories/slug-name to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^categories/([a-zA-Z0-9-]+)/?$ index.php?category_slug=$1 [L,QSA]

# Clean URL rules for existing pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(index|about|admin|categories|channel|suggestions)/?$ $1.php [L,QSA,E=REDIRECT:1]

# Allow direct access to API endpoints
RewriteCond %{REQUEST_URI} ^/bingeworthy/api/
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Default fallback to index.php (for 404 or other handling)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

# Allow direct access to static files (Apache 2.4 and 2.2 compatible)
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Protect sensitive files from direct access (Apache 2.4 and 2.2 compatible)
<FilesMatch "\.(db|sqlite|db\.bkp|yaml|yml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block dotfiles and common config manifests (Apache 2.4 and 2.2 compatible)
<FilesMatch "^(\.|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Smart caching for JS and CSS - must revalidate with server
<FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
</FilesMatch>

# PHP settings must not be set via .htaccess on many shared hosts (PHP-FPM).
# Use a .user.ini or cPanel MultiPHP INI Editor instead:
#   display_errors = Off
#   log_errors = On
#   error_reporting = E_ALL

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "no-referrer-when-downgrade"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP tuned for current assets and YouTube embeds
    Header set Content-Security-Policy "default-src 'self'; img-src 'self' https://img.youtube.com https://i.ytimg.com https://ytimg.com https://yt3.googleusercontent.com https://yt3.ggpht.com https://queue.simpleanalyticscdn.com https://startupfa.me https://wired.business https://starterbest.com/badages-awards.svg data:; style-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; script-src 'self' https://www.youtube.com https://cdn.jsdelivr.net https://scripts.simpleanalyticscdn.com 'unsafe-inline'; font-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net data:; connect-src 'self' https://queue.simpleanalyticscdn.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'"
</IfModule>

# Basic Auth for admin endpoints (production)
# NOTE: Update AuthUserFile to an absolute path on the server
<FilesMatch "^(admin\.php|admin_ajax\.php)$">
    AuthType Basic
    AuthName "Restricted Area"
    AuthUserFile "/home/etern13/_env/bingeworthy.htpasswd"
    Require valid-user
</FilesMatch>

# Never expose Apache ht* control files (e.g., .htaccess, .htpasswd) (Apache 2.4 and 2.2 compatible)
<Files ".ht*">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
