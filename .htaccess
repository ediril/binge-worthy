RewriteEngine On

# Disable directory listings
Options -Indexes

# Force HTTPS redirect
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.bingeworthyshows\.tv$ [NC]
RewriteRule ^(.*)$ https://bingeworthyshows.tv/$1 [L,R=301]

# Only allow bingeworthyshows.tv for PHP pages (not static assets)
RewriteCond %{HTTP_HOST} !^bingeworthyshows\.tv$ [NC]
RewriteCond %{REQUEST_URI} !^/static/
RewriteRule ^ - [R=404,L]

# Redirect old .php URLs to clean URLs (except API endpoints)
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/suggestions\.php$
RewriteCond %{REQUEST_URI} !^/admin\.php$
RewriteCond %{REQUEST_URI} !^/admin_ajax\.php$
RewriteRule ^ /%1? [R=301,L]

# Clean URL rules for existing pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(index|about|admin|categories|channel|suggestions)/?$ $1.php [L,QSA,E=REDIRECT:1]

# Default fallback to index.php (for 404 or other handling)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

# Allow direct access to static files (Apache 2.4 and 2.2 compatible)
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Protect sensitive files from direct access (Apache 2.4 and 2.2 compatible)
<FilesMatch "\.(db|sqlite|db\.bkp|yaml|yml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block dotfiles and common config manifests (Apache 2.4 and 2.2 compatible)
<FilesMatch "^(\.|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Smart caching for JS and CSS - must revalidate with server
<FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
</FilesMatch>

# PHP settings must not be set via .htaccess on many shared hosts (PHP-FPM).
# Use a .user.ini or cPanel MultiPHP INI Editor instead:
#   display_errors = Off
#   log_errors = On
#   error_reporting = E_ALL

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "no-referrer-when-downgrade"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP tuned for current assets and YouTube embeds
    # Allow YouTube thumbnails and channel avatars
    # - Video thumbnails commonly come from img.youtube.com / i.ytimg.com
    # - Channel avatars come from yt3.googleusercontent.com (and occasionally yt3.ggpht.com)
    Header set Content-Security-Policy "default-src 'self'; img-src 'self' https://img.youtube.com https://i.ytimg.com https://ytimg.com https://yt3.googleusercontent.com https://yt3.ggpht.com data:; style-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; font-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net data:; connect-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'"
</IfModule>

# Basic Auth for admin endpoints (production)
# NOTE: Update AuthUserFile to an absolute path on the server
<FilesMatch "^(admin\.php|admin_ajax\.php)$">
    AuthType Basic
    AuthName "Restricted Area"
    AuthUserFile "/home/etern13/_env/bingeworthy.htpasswd"
    Require valid-user
</FilesMatch>

# Never expose Apache ht* control files (e.g., .htaccess, .htpasswd) (Apache 2.4 and 2.2 compatible)
<Files ".ht*">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
